{
  "name": "dsh-desktop-web",
  "version": "2.4.0",
  "type": "module",
  "description": "Serve the DeepSeek Harness desktop Host to a browser on other addresses, with username/password sign-in, persistent sessions, optional TOTP two-factor and in-app bridge configuration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lstions/dsh-desktop-web.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "remote-access",
    "password-auth",
    "totp"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "gate.js",
    "config.js",
    "interfaces.js",
    "auth.js",
    "pages.js",
    "qr.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
